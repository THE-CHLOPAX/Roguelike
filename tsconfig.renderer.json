{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "esnext",
    "moduleResolution": "node",
    "target": "ES2020",
    "jsx": "react-jsx",
    "paths": {
      "@tgdf": ["src/lib/index.ts"],
      "@tgdf/*": ["src/lib/*"],
      "renderer/*": ["src/renderer/*"],
      "3D/*": ["src/renderer/3D/*"],
      "UI": ["src/renderer/ui/index.ts"]
    }
  },
  "include": ["src/renderer/**/*"],
  "exclude": ["src/main/**/*", "node_modules"]
}
